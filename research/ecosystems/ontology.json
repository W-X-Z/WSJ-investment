{
  "schema_version": "0.4",
  "as_of": "2026-10-27",
  "purpose": "seed_graph.json 이 따라야 하는 닫힌 어휘(closed vocabulary). 노드 종류·관계 술어의 정의역/치역·근거 등급·전파 방향을 한 곳에 둔다. 검증: python -m wsj.ecosystems.ontology --check",
  "node_kinds": {
    "ecosystem": {
      "layer": 0,
      "label_ko": "생태계",
      "description": "분석 단위가 되는 기술 공급망 (3개)"
    },
    "product_generation": {
      "layer": 0,
      "label_ko": "제품 세대",
      "description": "수요 측 세대 전환 (HBM3E→HBM4, 800G→1.6T, 54V→800VDC). 날짜 박힌 로드맵의 앵커"
    },
    "standard": {
      "layer": 0,
      "label_ko": "표준·사양",
      "description": "JEDEC·IEEE·OCP 등 공식 규격. 요구사항의 출처이자 감시 대상"
    },
    "requirement": {
      "layer": 1,
      "label_ko": "기술 요구",
      "description": "세대/표준이 강제하는 정량 요구 (I/O 수, lane rate, 버스 전압)"
    },
    "bottleneck": {
      "layer": 2,
      "label_ko": "병목",
      "description": "요구를 만족시킬 때 생기는 물리·수율·비용 문제"
    },
    "technology": {
      "layer": 3,
      "label_ko": "기술 방식",
      "description": "병목을 푸는 일반 기술 (하이브리드 본딩, CPO). 특정 회사 제품이 아님"
    },
    "process": {
      "layer": 4,
      "label_ko": "공정·검사",
      "description": "제조·검사 공정 단계"
    },
    "component": {
      "layer": 4,
      "label_ko": "부품·모듈",
      "description": "BOM 구성 요소"
    },
    "material": {
      "layer": 4,
      "label_ko": "소재",
      "description": "소재·기판·웨이퍼"
    },
    "equipment": {
      "layer": 4,
      "label_ko": "장비 유형",
      "description": "공정을 수행하는 장비의 일반 유형 (본더, 검사기)"
    },
    "product": {
      "layer": 5,
      "label_ko": "제품",
      "description": "특정 회사의 판매 제품/제품군. technology 를 implements 하고 company 가 offers"
    },
    "company": {
      "layer": 6,
      "label_ko": "기업",
      "description": "공급·수요 기업. role 필수: supplier | customer | both. 상장사는 listing 필수. 여러 생태계에 걸치면 also_in: [eco,...]"
    },
    "demand_driver": {
      "layer": 0,
      "label_ko": "수요 동인",
      "description": "워크로드·사용 방식의 변화가 만드는 수요 (에이전트 추론, 긴 컨텍스트, KV 캐시 상주). 세대·표준보다 앞선 층 — 관측치(obs:*)로 크기를 재고 구조 가설(ADR-0025)의 출발점이 된다"
    }
  },
  "company_fields": {
    "role": [
      "supplier",
      "customer",
      "both"
    ],
    "listing": {
      "ticker": "string|null",
      "exchange": "string|null",
      "cik": "int|null",
      "filer_type": "10-K|20-F|40-F|non_sec_listed|private"
    },
    "in_universe": "core.companies.in_universe 와 동기화 (공개유동 $10M~1B, 10-K 필러). 수혜 후보 필터의 1차 기준",
    "size_band": [
      "micro",
      "small",
      "mid",
      "large",
      "mega",
      "private"
    ]
  },
