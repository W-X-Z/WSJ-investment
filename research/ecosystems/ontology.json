  "evidence_tiers": {
    "independent_measurement": {
      "confidence": 0.95,
      "label_ko": "독립 실측·논문",
      "description": "이해관계 없는 제3자의 측정/표준 시험"
    },
    "standard_body": {
      "confidence": 0.9,
      "label_ko": "표준 기구 문서",
      "description": "JEDEC/IEEE/OCP 공식 문서·PAR·발행본"
    },
    "official_issuer": {
      "confidence": 0.8,
      "label_ko": "당사자 공식 공시",
      "description": "SEC 공시·공식 보도자료·기술 노트 (당사자가 자기 행위를 진술)"
    },
    "customer_statement": {
      "confidence": 0.8,
      "label_ko": "고객사 공식 진술",
      "description": "수요 기업이 공급사/기술 채택을 명시 (NVIDIA 파트너 목록 등)"
    },
    "vendor_claim": {
      "confidence": 0.55,
      "label_ko": "공급사 성능 주장",
      "description": "데이터시트·마케팅 수치. 독립 검증 없음"
    },
    "third_party_report": {
      "confidence": 0.6,
      "label_ko": "제3자 보도·리서치",
      "description": "전문 매체·애널리스트 보도. 원문 인용 여부로 가중"
    },
    "technical_inference": {
      "confidence": 0.4,
      "label_ko": "기술적 추론",
      "description": "물리·공정 상식에서 끌어낸 연결. 출처는 배경 자료"
    },
    "hypothesis": {
      "confidence": 0.25,
      "label_ko": "가설",
      "description": "검증 전 시나리오"
    }
  },
  "legacy_stage_to_tier": {
    "established": "official_issuer",
    "issuer_documented": "official_issuer",
    "documented_architecture": "official_issuer",
    "standard_draft": "standard_body",
    "standardization_in_progress": "standard_body",
    "vendor_claim": "vendor_claim",
    "technology_option": "technical_inference",
    "technical_inference": "technical_inference",
    "scenario": "hypothesis",
    "unverified_hypothesis": "hypothesis"
  },
  "polarity": [
    "positive",
    "negative",
    "conditional"
  ],
  "edge_required_fields": [
    "id",
    "from",
    "to",
    "relation",
    "evidence_tier",
    "polarity",
    "evidence"
  ],
  "evidence_required_fields": [
    "url",
    "source_type"
  ],
  "evidence_optional_fields": [
    "published_at",
    "date_precision",
    "excerpt",
    "note"
  ],
  "lint_rules": {
    "max_edges_per_source_url": 12,
    "company_needs_listing_or_private_flag": true,
    "supplied_to_min_tier": "official_issuer",
    "product_must_have_implements_and_offered_by": true,
    "every_ecosystem_needs_customer": true
  },
  "edge_optional_fields": [
    "note",
    "about (기업↔기업 관계가 관한 기술/세대 노드 id — 영향 전파는 about 노드를 지난 경로에서만 이 관계를 탄다)",
    "confidence (검증기가 계산)",
    "exposure (offered_by·supplied_to: 그 제품·거래가 공급사 매출에서 차지하는 비중 — core ≥50% · major 10~50% · minor <10% · unknown. 해석·보강 작업이 원문으로 확인할 때만 채운다)",
    "position (offered_by: 그 제품에서 공급사의 자리 — leader 선두 · second_source 2순위 공급사 · entrant 진입·인증 중 · captive 자체 생산(외부 판매 없음))",
    "exposure_pct · exposure_year · exposure_source (offered_by·supplied_to: 매출 비중 숫자와 기준 연도·출처 — 범주 exposure 와 함께 둘 수 있다)",
    "content_usd_per_system (requires·raises_content) · lead_time_weeks (requires·offered_by) · effective_date (mandates)"
  ],
  "maturity_stages": {
    "early": "연구·시연·시제품",
    "near": "고객 샘플·인증",
    "commercial": "양산·채택"
  },
  "maturity_field": {
    "applies_to": [
      "technology",
      "process",
      "material",
      "component",
      "equipment",
      "product",
      "product_generation"
    ],
    "shape": {
      "stage": "maturity_stages 의 키",
      "as_of": "YYYY-MM-DD",
      "evidence_url": "https://...",
      "evidence_tier": "evidence_tiers 의 키",
      "note": "string|null"
    },
    "rule": "현재 단계 1개만, 3단계로 거칠게. 근거 사실은 DB ideas.tech_evidence (ADR-0015 §3-1)"
  },
  "edge_attributes": {
    "exposure": {
      "applies_to": [
        "offered_by",
        "supplied_to"
      ],
      "values": [
        "core",
        "major",
        "minor",
        "unknown"
      ]
    },
    "position": {
      "applies_to": [
        "offered_by"
      ],
      "values": [
        "leader",
        "second_source",
        "entrant",
        "captive"
      ]
    },
    "exposure_pct": {
      "applies_to": [
        "offered_by",
        "supplied_to"
      ],
      "type": "number",
      "min": 0,
      "max": 100,
      "note": "그 제품·거래가 공급사 매출에서 차지하는 비중(%) — 원문 숫자가 있을 때만. exposure_year·exposure_source 와 함께"
    },
    "exposure_year": {
      "applies_to": [
        "offered_by",
        "supplied_to"
      ],
      "type": "integer",
      "min": 2000,
      "max": 2100
    },
    "exposure_source": {
      "applies_to": [
        "offered_by",
        "supplied_to"
      ],
      "type": "url"
    },
    "content_usd_per_system": {
      "applies_to": [
        "requires",
        "raises_content"
      ],
      "type": "number",
      "min": 0,
      "note": "시스템(서버·랙·모듈) 하나에 들어가는 이 부품·소재의 금액(달러)"
    },
    "lead_time_weeks": {
      "applies_to": [
        "requires",
        "offered_by"
      ],
      "type": "number",
      "min": 0,
      "max": 520
    },
    "effective_date": {
      "applies_to": [
        "mandates"
      ],
      "type": "date",
      "note": "규칙이 강제되기 시작하는 날"
    }
  },
  "node_fields": {
    "status": {
      "values": [
        "active",
        "candidate"
      ],
      "default": "active",
      "rule": "candidate = 근거 1개로 먼저 들어온 노드(사전 밖 용어·그래프 밖 상장사). 두 층 이상에서 보이거나 매출 근거가 붙으면 active. 후보는 병목 연결 검사에서 뺀다"
    },
    "first_seen": {
      "type": "date",
      "rule": "우리가 처음 본 날 (패치·수집 날짜)"
    },
    "first_evidence": {
      "shape": {
        "date": "YYYY-MM-DD",
        "url": "https://...",
        "layer": "standard|conference|paper|patent|jobs|code|rule|filing|press|other"
      },
      "rule": "근거상 처음 나온 날과 그 층 — 위층(표준·학회)에서 아래층(채용·코드·공시)으로 내려오는 순서를 본다"
    },
    "maturity_history": {
      "shape": "[maturity_field.shape …]",
      "rule": "단계가 바뀔 때마다 한 줄 더한다. 현재 단계는 maturity"
    },
    "codes": {
      "keys": [
        "cpc",
        "jesd",
        "oif_ia",
        "ieee",
        "ocp",
        "rule",
        "nerc",
        "hs",
        "part"
