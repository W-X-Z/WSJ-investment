# --- Store ---
# postgrest (기본, Supabase) | sqlite (로컬 검증)
WSJ_STORE=postgrest
WSJ_SQLITE_PATH=./data/wsj.sqlite

# Supabase. 서비스 롤(secret) 키는 파이프라인 전용 — 절대 프론트/레포에 넣지 않는다.
SUPABASE_URL=https://dcatgfivsvbktylmtvgf.supabase.co
SUPABASE_SECRET_KEY=

# --- 소스별 ---
# SEC는 User-Agent에 이름/이메일이 없으면 차단한다.
SEC_USER_AGENT=WSJ-investment research dnltmdwhd@gmail.com
# openFDA: 없으면 1,000/일, 있으면 120,000/일 (https://open.fda.gov/apis/authentication/)
OPENFDA_API_KEY=

# --- 로깅 ---
WSJ_LOG_LEVEL=INFO
